  "components": {
    "schemas": {
      "Advance": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Epoch"
          },
          "action": {
            "type": "string",
            "const": "advance",
            "title": "Action",
            "default": "advance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "expected_revision",
          "epoch"
        ],
        "title": "Advance"
      },
      "AnswerQuest": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Epoch"
          },
          "action": {
            "type": "string",
            "const": "quest",
            "title": "Action",
            "default": "quest"
          },
          "quest_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Quest Id"
          },
          "choice_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Choice Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "expected_revision",
          "epoch",
          "quest_id",
          "choice_id"
        ],
        "title": "AnswerQuest"
      },
      "Appearance": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Name",
            "default": "Финни"
          },
          "body": {
            "type": "string",
            "enum": [
              "cat",
              "fox",
              "bunny"
            ],
            "title": "Body",
            "default": "cat"
          },
          "color": {
            "type": "string",
            "enum": [
              "mint",
              "peach",
              "lavender"
            ],
            "title": "Color",
            "default": "mint"
          },
          "accessory": {
            "type": "string",
            "enum": [
              "none",
              "bow",
              "hat"
            ],
            "title": "Accessory",
            "default": "none"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Appearance"
      },
      "BalanceState": {
        "properties": {
          "wallet": {
            "type": "integer",
            "title": "Wallet"
          },
          "savings": {
            "type": "integer",
            "title": "Savings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "wallet",
          "savings"
        ],
        "title": "BalanceState"
      },
      "Budget": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Epoch"
          },
          "action": {
            "type": "string",
            "const": "budget",
            "title": "Action",
            "default": "budget"
          },
          "required": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Required"
          },
          "wanted": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Wanted"
          },
          "savings": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Savings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "expected_revision",
          "epoch",
          "required",
          "wanted",
          "savings"
        ],
        "title": "Budget"
      },
      "CatalogItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "data"
        ],
        "title": "CatalogItem"
      },
      "CommandResult": {
        "properties": {
          "operation_id": {
