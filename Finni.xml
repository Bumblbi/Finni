<file path="backend/deploy/nginx.conf">
events { worker_connections 1024; }
http {
    server_tokens off;
    access_log off;
    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=registration:10m rate=5r/m;
    upstream finni { server api:8000; }
    server {
        listen 80;
        client_max_body_size 256k;
        limit_req_status 429;
        location = /api/v1/profiles {
            limit_req zone=registration burst=5 nodelay;
            proxy_pass http://finni;
            proxy_set_header Host $host;
        }
        location / {
            limit_req zone=api burst=40 nodelay;
            proxy_pass http://finni;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 30s;
        }
    }
}
